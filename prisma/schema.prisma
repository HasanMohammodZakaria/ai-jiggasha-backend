// Jiggasha database schema (built slice by slice)
// Prisma 6.x pinned

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String    @map("full_name") @db.VarChar(80)
  email            String    @unique @db.VarChar(255)
  passwordHash     String?   @map("password_hash")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  avatarStorageKey String?   @map("avatar_storage_key")
  avatarUrl        String?   @map("avatar_url") @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  authAccounts        AuthAccount[]
  passwordResetTokens PasswordResetToken[]
  subjects            Subject[]
  documents           Document[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum AuthProvider {
  GOOGLE
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  email             String       @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model PasswordResetToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at")
  usedAt             DateTime? @map("used_at")
  requestedIp        String?   @map("requested_ip") @db.VarChar(64)
  requestedUserAgent String?   @map("requested_user_agent") @db.VarChar(512)
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum DocumentFileType {
  PDF
  DOCX
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([userId, name])
  @@map("subjects")
}

model Document {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  subjectId    String?          @map("subject_id") @db.Uuid
  title        String           @db.VarChar(255)
  originalName String           @map("original_name") @db.VarChar(255)
  fileType     DocumentFileType @map("file_type")
  mimeType     String           @map("mime_type") @db.VarChar(100)
  sizeBytes    Int              @map("size_bytes")
  sha256       String           @db.VarChar(64)
  storageKey   String           @map("storage_key")
  status       DocumentStatus   @default(UPLOADED)
  errorMessage String?          @map("error_message") @db.VarChar(500)
  pageCount    Int?             @map("page_count")
  language     String?          @db.VarChar(10)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chunks  DocumentChunk[]

  @@index([userId, subjectId])
  @@index([userId, status])
  @@index([userId, sha256])
  @@map("documents")
}

// user_id is copied here on purpose: retrieval can filter "WHERE user_id = ..." directly.
// Deleting a user deletes their documents, which deletes these chunks.
model DocumentChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  documentId     String                      @map("document_id") @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  chunkIndex     Int                         @map("chunk_index")
  pageStart      Int?                        @map("page_start")
  pageEnd        Int?                        @map("page_end")
  sectionLabel   String?                     @map("section_label") @db.VarChar(255)
  content        String
  tokenCount     Int                         @map("token_count")
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                     @map("embedding_model") @db.VarChar(100)
  createdAt      DateTime                    @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([userId, documentId])
  @@map("document_chunks")
}

model AiUsageLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  provider  String   @db.VarChar(40)
  model     String   @db.VarChar(100)
  operation String   @db.VarChar(40)
  units     Int      @default(1)
  tokensIn  Int?     @map("tokens_in")
  latencyMs Int      @map("latency_ms")
  status    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([operation, createdAt])
  @@map("ai_usage_logs")
}